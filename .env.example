# Демо-режим работает без ключей. Скопируйте файл в .env.local:
#   cp .env.example .env.local
#   Windows (PowerShell): Copy-Item .env.example .env.local

# Возможные значения: mock | openai | gigachat | yandex
AI_PROVIDER=mock

# OpenAI или любой OpenAI-совместимый API (OpenRouter, LM Studio, vLLM, локальная модель)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# GigaChat: токен/ключ из личного кабинета Сбера
GIGACHAT_API_KEY=
GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_MODEL=GigaChat-2

# YandexGPT: folder id + API-ключ из IAM. Инструменты (tools) здесь НЕ поддерживаются.
YANDEX_FOLDER_ID=
YANDEX_API_KEY=
YANDEX_MODEL=yandexgpt

# 0 — отключить передачу tools провайдеру (если модель их не понимает)
AI_SUPPORTS_TOOLS=1

# Максимум шагов цикла «модель -> инструмент -> модель»
AGENT_MAX_STEPS=5

# Продуктовый сервер (npm start)
PORT=3000
HOST=0.0.0.0
